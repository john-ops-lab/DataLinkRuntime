  "slug": "alicloud-network-ingress-topology",
  "theme_slug": "cloud-cmdb",
  "title": {
    "zh-CN": "阿里云网络与流量入口拓扑",
    "en": "Alibaba Cloud Network & Ingress Topology"
  },
  "summary": {
    "zh-CN": "为已核对的 VPC、交换机、公网地址、网关、ACL、VPN 与证书操作生成字节有界的规范化预览。",
    "en": "Produce a byte-bounded normalized preview for checked VPC, VSwitch, public-IP, gateway, ACL, VPN, and certificate operations."
  },
  "details": {
    "zh-CN": "执行表仅分页读取已核对的 VPC、VSwitch、EIP、NAT 网关、网络 ACL、VPN 网关和证书。路由、SLB、DNS 与推断流量路径只在来源矩阵中列为 gap，不会被 Recipe 请求。",
    "en": "The executable table pages only checked VPC, VSwitch, EIP, NAT gateway, network ACL, VPN gateway, and certificate operations. Routes, SLB, DNS, and inferred traffic paths remain source-matrix gaps and are not requested by the Recipe."
  },
  "input_summary": {
    "zh-CN": "账号、区域、网络资源族、模式与 sync 稳定标识。",
    "en": "Account, regions, network resource families, mode and stable sync identity."
  },
  "output_summary": {
    "zh-CN": "有界网络资产与关系预览，或无全量明细的同步摘要。",
    "en": "Bounded network asset and relationship preview, or sync summary without full inventory."
  },
  "risk": {
    "zh-CN": "不推断端到端流量路径；权限缺口会使结果 partial 并阻止 finish。当前 Alibaba Cloud SDK callApi 的传输层响应无法证明受字节上限约束；max_bytes 只限制规范化输出与 fixture 处理，本 Variant 仍为 reference-generated。",
    "en": "Does not infer end-to-end traffic paths; permission gaps make the result partial and prevent finish. The transport response from Alibaba Cloud SDK callApi is not proven byte-bounded; max_bytes limits normalized output and fixture processing only, and this Variant remains reference-generated."
  },
  "vendor": "Alibaba Cloud",
