{
  "slug": "alicloud-compute-container-topology",
  "theme_slug": "cloud-cmdb",
  "title": {
    "zh-CN": "阿里云计算与容器拓扑",
    "en": "Alibaba Cloud Compute & Container Topology"
  },
  "summary": {
    "zh-CN": "为已核对的 ECS、云盘、网卡、镜像与伸缩组生成字节有界的规范化预览，并可幂等同步到窄 CMDB 合同。",
    "en": "Produce a byte-bounded normalized preview for checked ECS, disk, network-interface, image, and scaling-group operations, with optional idempotent CMDB sync."
  },
  "details": {
    "zh-CN": "执行表仅包含已核对的 ECS 实例、云盘、弹性网卡、镜像和伸缩组只读 OpenAPI；按区域生成稳定资产键和显式关系。ACK 与推断工作负载拓扑只在来源矩阵中列为 gap，不会被 Recipe 请求。",
    "en": "The executable table contains only checked read-only OpenAPI operations for ECS instances, disks, ENIs, images, and Auto Scaling groups, emitting stable keys and explicit relationships per region. ACK and inferred workload topology remain source-matrix gaps and are not requested by the Recipe."
  },
  "input_summary": {
    "zh-CN": "账号、区域、资源族、模式，以及 sync 所需稳定扫描标识。",
    "en": "Account, regions, resource families, mode, and stable scan identity for sync."
  },
  "output_summary": {
    "zh-CN": "preview 返回有界资产快照；sync 只返回计数、失败范围和 checkpoint 摘要。",
    "en": "Preview returns a bounded asset snapshot; sync returns counts, failed scopes and checkpoint summary only."
  },
  "risk": {
    "zh-CN": "需要最小只读云权限；关系不做猜测，部分失败时禁止 finish。当前 Alibaba Cloud SDK callApi 的传输层响应无法证明受字节上限约束；max_bytes 只限制规范化输出与 fixture 处理，本 Variant 仍为 reference-generated。",
    "en": "Requires least-privilege cloud read access; relationships are not inferred and finish is forbidden after partial failure. The transport response from Alibaba Cloud SDK callApi is not proven byte-bounded; max_bytes limits normalized output and fixture processing only, and this Variant remains reference-generated."
  },
