  "slug": "servicenow-cmdb-ci-snapshot",
  "theme_slug": "cloud-cmdb",
  "title": {
    "zh-CN": "ServiceNow CMDB CI 快照",
    "en": "ServiceNow CMDB CI Snapshot"
  },
  "summary": {
    "zh-CN": "有界读取 cmdb_ci，支持条件、字段、显示值和分页，并可幂等同步。",
    "en": "Boundedly read cmdb_ci with query, field, display-value and pagination controls, with optional idempotent sync."
  },
  "details": {
    "zh-CN": "默认仅调用 Table API 的 cmdb_ci，不请求 cmdb_rel_ci，也不声称首期支持关系拓扑。",
    "en": "Calls only cmdb_ci through the Table API by default, never requests cmdb_rel_ci, and does not claim relationship topology in the first release."
  },
  "input_summary": {
    "zh-CN": "实例地址、encoded query、字段、显示值策略、模式与 sync 稳定标识。",
    "en": "Instance URL, encoded query, fields, display-value policy, mode and stable sync identity."
  },
  "output_summary": {
    "zh-CN": "CI 资产快照，或计数、失败和 checkpoint 同步摘要。",
    "en": "CI asset snapshot, or counts, failures and checkpoint sync summary."
  },
  "risk": {
    "zh-CN": "实例地址和认证不得回显；来源响应与最终输出均受 max_bytes 限制，页内 partial 从首条未处理记录恢复并阻止 finish。",
    "en": "Instance URL and credentials are never echoed; max_bytes bounds source responses and the final output, while an in-page partial resumes at the first unprocessed record and prevents finish."
  },
  "vendor": "ServiceNow",
  "adapter_type": "task",
