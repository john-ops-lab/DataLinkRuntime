  "slug": "csv-to-json",
  "theme_slug": "file-data",
  "title": {
    "zh-CN": "CSV 转 JSON",
    "en": "CSV to JSON"
  },
  "summary": {
    "zh-CN": "在行、列、字段和总输出上限内解析 CSV 内容。",
    "en": "Parse CSV content within row, column, field and total-output bounds."
  },
  "details": {
    "zh-CN": "支持编码、UTF BOM、表头、分隔符、引号内换行和空行策略；可直接使用执行输入，不要求 Managed Input Store。",
    "en": "Supports encoding, UTF BOM, headers, delimiters, quoted newlines and blank-line policy; direct execution input works without Managed Input Store."
  },
  "input_summary": {
    "zh-CN": "受限 CSV 内容、编码、分隔符、表头和空行策略。",
    "en": "Bounded CSV content, encoding, delimiter, header and blank-line policy."
  },
  "output_summary": {
    "zh-CN": "完整 JSON rows（表头模式下每行是字段对象）、计数、partial/checkpoint、解码编码与分隔符。",
    "en": "Complete JSON rows (field objects in header mode), count, partial/checkpoint state, decoded encoding and delimiter."
  },
  "risk": {
    "zh-CN": "超限前停止并返回完整 JSON 或明确错误，不返回损坏片段。",
    "en": "Stops before limits with complete JSON or an explicit error, never a corrupt fragment."
  },
