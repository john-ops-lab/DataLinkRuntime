  "summary": {
    "zh-CN": "有界预览 CVM、CBS、镜像、专用宿主机、伸缩组与 TKE。",
    "en": "Boundedly preview CVM, CBS, images, dedicated hosts, scaling groups and TKE."
  },
  "details": {
    "zh-CN": "执行表仅包含已核对的 CVM、CBS、镜像、专用宿主机、伸缩组和 TKE 只读 API；按地域生成稳定资产键和显式关系。推断工作负载拓扑只在来源矩阵中列为 gap。",
    "en": "The executable table contains only checked read-only APIs for CVM, CBS, images, dedicated hosts, Auto Scaling groups, and TKE, emitting stable keys and explicit relationships per region. Inferred workload topology remains a source-matrix gap."
  },
  "input_summary": {
    "zh-CN": "账号、地域、资源族、模式和 sync 稳定扫描标识。",
    "en": "Account, regions, resource families, mode and stable sync identity."
  },
  "output_summary": {
    "zh-CN": "有界计算与容器快照，或只含摘要的同步结果。",
    "en": "Bounded compute and container snapshot, or summary-only sync result."
  },
  "risk": {
    "zh-CN": "需要最小只读 CAM 权限；区域失败时禁止 finish。",
    "en": "Requires least-privilege read-only CAM permissions; regional failure prevents finish."
  },
