  "title": {
    "zh-CN": "腾讯云数据库与中间件清单",
    "en": "Tencent Cloud Database & Middleware Inventory"
  },
  "summary": {
    "zh-CN": "有界盘点 TencentDB、消息、存储、身份、日志、WAF 与证书资源。",
    "en": "Boundedly inventory TencentDB, messaging, storage, identity, logs, WAF and certificates."
  },
  "details": {
    "zh-CN": "执行表仅包含已核对的 CDB、PostgreSQL、Redis、MongoDB、SQL Server、MariaDB、Elasticsearch、CKafka、CFS、CAM、CLS、WAF 和 SSL API。TDSQL-C、COS 与推断应用依赖只在来源矩阵中列为 gap，不会被 Recipe 请求。",
    "en": "The executable table contains only checked APIs for CDB, PostgreSQL, Redis, MongoDB, SQL Server, MariaDB, Elasticsearch, CKafka, CFS, CAM, CLS, WAF, and SSL. TDSQL-C, COS, and inferred application dependencies remain source-matrix gaps and are not requested by the Recipe."
  },
  "input_summary": {
    "zh-CN": "账号、地域、产品资源族、模式与 sync 稳定标识。",
    "en": "Account, regions, product resource families, mode and stable sync identity."
  },
  "output_summary": {
    "zh-CN": "确定性清单预览或不回传完整资产的同步摘要。",
    "en": "Deterministic inventory preview or sync summary without full asset payload."
  },
  "risk": {
    "zh-CN": "开源覆盖缺口由官方 API 事实补齐，但没有实连证据；部分失败不会 finish。",
    "en": "Open-source gaps are filled by official API facts without live evidence; partial failure never finishes."
  },
