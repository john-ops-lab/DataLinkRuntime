  "title": {
    "zh-CN": "腾讯云网络与流量入口拓扑",
    "en": "Tencent Cloud Network & Ingress Topology"
  },
  "summary": {
    "zh-CN": "采集 VPC、子网、网卡、公网地址、网关、路由、ACL、CCN、VPN 与 CLB 链路。",
    "en": "Collect VPC, subnet, network interface, public IP, gateway, route, ACL, CCN, VPN and CLB chains."
  },
  "details": {
    "zh-CN": "执行表仅分页读取已核对的 VPC、子网、网卡、EIP、NAT、路由表、网络 ACL、CCN、VPN、CLB 和目标组。监听器与推断流量路径只在来源矩阵中列为 gap，不会被 Recipe 请求。",
    "en": "The executable table pages only checked VPC, subnet, ENI, EIP, NAT, route-table, network ACL, CCN, VPN, CLB, and target-group operations. Listeners and inferred traffic paths remain source-matrix gaps and are not requested by the Recipe."
  },
  "input_summary": {
    "zh-CN": "账号、地域、网络资源族、模式与 sync 稳定标识。",
    "en": "Account, regions, network resource families, mode and stable sync identity."
  },
  "output_summary": {
    "zh-CN": "网络资产关系预览或有界同步摘要。",
    "en": "Network asset relationship preview or bounded sync summary."
  },
  "risk": {
    "zh-CN": "不将推测的流量路径当作事实；产品或地域失败会阻止 finish。",
    "en": "Does not present inferred traffic paths as facts; product or region failures prevent finish."
  },
