{
  "slug": "webhook-json-normalization",
  "theme_slug": "api-events",
  "title": {
    "zh-CN": "Webhook JSON 校验与标准化",
    "en": "Webhook JSON Validation & Normalization"
  },
  "summary": {
    "zh-CN": "校验必填字段、重命名嵌套值并把时间统一为 ISO-8601 UTC。",
    "en": "Validate required fields, rename nested values and normalize timestamps to ISO-8601 UTC."
  },
  "details": {
    "zh-CN": "使用有限的点分隔路径读取，不提供表达式 DSL，不访问外部系统，也不提供 sync。",
    "en": "Uses limited dotted paths without an expression DSL, external calls or sync mode."
  },
  "input_summary": {
    "zh-CN": "Webhook payload、必填路径、字段映射和时间字段列表。",
    "en": "Webhook payload, required paths, field map and timestamp fields."
  },
  "output_summary": {
    "zh-CN": "标准化对象和字段级验证错误。",
    "en": "Normalized object and field-level validation errors."
  },
  "risk": {
    "zh-CN": "无效路径或时间明确报错；不会静默丢弃必填字段。",
    "en": "Invalid paths or timestamps produce explicit errors; required fields are never silently dropped."
  },
