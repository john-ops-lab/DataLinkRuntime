{
  "slug": "alicloud-database-middleware-inventory",
  "theme_slug": "cloud-cmdb",
  "title": {
    "zh-CN": "阿里云数据库与中间件清单",
    "en": "Alibaba Cloud Database & Middleware Inventory"
  },
  "summary": {
    "zh-CN": "为已核对的数据库、中间件、文件存储、身份与安全操作生成字节有界的规范化预览。",
    "en": "Produce a byte-bounded normalized preview for checked database, middleware, file-storage, identity, and security operations."
  },
  "details": {
    "zh-CN": "执行表仅分页读取已核对的 RDS、Redis、MongoDB、NAS、RAM、KMS、ActionTrail 和安全中心资源。Elasticsearch、OSS、SLS 与推断应用依赖只在来源矩阵中列为 gap，不会被 Recipe 请求。",
    "en": "The executable table pages only checked RDS, Redis, MongoDB, NAS, RAM, KMS, ActionTrail, and Security Center operations. Elasticsearch, OSS, SLS, and inferred application dependencies remain source-matrix gaps and are not requested by the Recipe."
  },
  "input_summary": {
    "zh-CN": "账号、区域、产品资源族、模式与 sync 稳定标识。",
    "en": "Account, regions, product resource families, mode and stable sync identity."
  },
  "output_summary": {
    "zh-CN": "确定性排序去重的资产快照，或有界同步摘要。",
    "en": "Deterministically sorted and deduplicated asset snapshot, or bounded sync summary."
  },
  "risk": {
    "zh-CN": "不猜测应用依赖；未授权产品会标记 partial 且不会触发失效清扫。当前 Alibaba Cloud SDK callApi 的传输层响应无法证明受字节上限约束；max_bytes 只限制规范化输出与 fixture 处理，本 Variant 仍为 reference-generated。",
    "en": "Does not infer application dependencies; unauthorized products are partial and never trigger stale cleanup. The transport response from Alibaba Cloud SDK callApi is not proven byte-bounded; max_bytes limits normalized output and fixture processing only, and this Variant remains reference-generated."
  },
  "vendor": "Alibaba Cloud",
