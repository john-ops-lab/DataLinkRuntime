# Append this section to the private Control HAProxy configuration on both LBs.
# PostgreSQL terminates TLS. Keep the private VIP and caller ACL aligned on both LBs.
# Before the 200 rule in local_proxy_health, add the following rule when enabling this section.
#   http-request return status 503 unless { nbsrv(postgres_primary) eq 1 }
frontend postgres_rw
    mode tcp
    bind 192.0.2.20:6432
    tcp-request connection reject unless { src 192.0.2.10 192.0.2.11 }
    default_backend postgres_primary

backend postgres_primary
    mode tcp
    timeout connect 2s
    timeout server 660s
    timeout check 2s
    retries 0
    default-server check inter 2s fall 2 rise 1 on-marked-down shutdown-sessions
    server pg_a 192.0.2.31:5432 disabled
    server pg_b 192.0.2.32:5432 disabled
    server pg_c 192.0.2.33:5432 disabled
