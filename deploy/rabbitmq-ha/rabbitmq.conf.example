# Copy per broker. Replace both listener addresses and all three Erlang names.
listeners.tcp = none
listeners.ssl.1 = 192.0.2.21:5671
ssl_options.cacertfile = /run/dlr-broker-tls/ca.pem
ssl_options.certfile = /run/dlr-broker-tls/node.pem
ssl_options.keyfile = /run/dlr-broker-tls/node.key

management.tcp.ip = 127.0.0.1
management.ssl.ip = 192.0.2.21
management.ssl.port = 15671
management.ssl.cacertfile = /run/dlr-broker-tls/ca.pem
management.ssl.certfile = /run/dlr-broker-tls/node.pem
management.ssl.keyfile = /run/dlr-broker-tls/node.key
loopback_users.guest = true

cluster_formation.peer_discovery_backend = classic_config
cluster_formation.classic_config.nodes.1 = rabbit@broker-a.example.invalid
cluster_formation.classic_config.nodes.2 = rabbit@broker-b.example.invalid
cluster_formation.classic_config.nodes.3 = rabbit@broker-c.example.invalid
queue_leader_locator = balanced
