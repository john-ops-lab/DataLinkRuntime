# Copy outside the repository, restrict to 0600 and replace every value.
# The runtime login must not own the database/schema/tables or have admin roles.
DATABASE_URL=postgresql+psycopg://dlr_wave1a_runtime:REPLACE@postgres.example.invalid:5432/dlr_wave1a
DLR_WORKER_V4_DATABASE_ROLE=dlr_wave1a_runtime
DLR_WORKER_V4_DATABASE_ADMIN_ROLES=["postgres"]
# Only 1 (default) or 2. Set the same value in the private Compose environment,
# whose explicit environment entry takes precedence over this env_file.
DLR_WORKER_V4_CONTROL_SLOTS=1
DLR_ADMIN_TOKEN=REPLACE_WITH_PRIVATE_RANDOM_ADMIN_TOKEN
DLR_WORKER_TOKEN=REPLACE_WITH_PRIVATE_RANDOM_LEGACY_NAMESPACE_TOKEN
DLR_MASTER_KEY=REPLACE_WITH_PRIVATE_RANDOM_MASTER_KEY
DLR_RABBITMQ_URL=amqps://CONTROL_USER:URL_ENCODED_PRIVATE_PASSWORD@broker.example.invalid:5671/
DLR_RABBITMQ_MANAGEMENT_URL=https://broker-management.example.invalid
# Enable after both queue families have three synchronized voting members.
# DLR_RABBITMQ_HA_ENABLED=true
# DLR_RABBITMQ_MANAGEMENT_USER=PRIVATE_READ_ONLY_MANAGEMENT_USER
# DLR_RABBITMQ_MANAGEMENT_PASSWORD=PRIVATE_READ_ONLY_MANAGEMENT_PASSWORD
SSL_CERT_FILE=/run/dlr-private/ca.pem
DLR_HTTP_INGRESS_ENABLED=false
DLR_MANAGED_FILES_ENABLED=false
DLR_SANDBOX_CPU_CORES=1.0
DLR_SANDBOX_MEMORY_BYTES=536870912
DLR_SANDBOX_PIDS=128
DLR_SANDBOX_TMP_BYTES=1073741824
DLR_SANDBOX_NOFILE=1024

# Optional W1-H policy; absent denies business credentials only.
# Configure only after installing a valid owner-only 0600 policy in this mount.
# DLR_WORKER_BUSINESS_CREDENTIAL_POLICY_FILE=/run/dlr-private/business-credentials.json
