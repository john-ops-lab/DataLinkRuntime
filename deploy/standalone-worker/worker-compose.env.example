# Copy outside the repository. Every address/name below is a placeholder.
COMPOSE_PROJECT_NAME=dlr-wave1a-worker
DLR_WORKER_IMAGE=registry.example.invalid/dlr-worker@sha256:REPLACE_WITH_REVIEWED_DIGEST
# Default needs only Python. W1-G adds explicit python_javascript after a real
# fixed Node 22 / standard sandbox harness probe; unknown values refuse startup.
# The dependency-free compiled modes require their native sandbox probes:
# python_javascript_typescript_java or python_javascript_typescript_java_go.
DLR_WORKER_LANGUAGE_MODE=python
DLR_WORKER_INPUT_MODE=disabled
# Set pure_python only on a managed-files Worker qualified for frozen wheels.
DLR_WORKER_BUILTIN_WHEEL_MODE=disabled
# Optional, separately mounted Worker-owned version cache. Leave empty for
# the ephemeral runtime. An existing nonempty volume needs its v4 owner marker.
DLR_WORKER_CACHE_ROOT=
# W1-H opt-in; capability alone grants no Credential permission.
DLR_WORKER_BUSINESS_CREDENTIALS_MODE=disabled
DLR_CONTROL_URL=https://control.example.invalid
DLR_WORKER_ID=REPLACE_WITH_RESERVED_ID
DLR_WORKER_IDENTITY_ID=REPLACE_WITH_RESERVED_UUID
DLR_WORKER_RUNTIME_VOLUME=dlr-wave1a-worker-runtime
DLR_WORKER_JOURNAL_ANCHOR_HOST_PATH=/ABSOLUTE/PERSISTENT/PARENT/journal
DLR_WORKER_PRIVATE_DIRECTORY=/ABSOLUTE/PRIVATE/DIRECTORY
# Set true only for the redundant RabbitMQ deployment to request a 10s AMQP heartbeat.
DLR_RABBITMQ_HA_ENABLED=false
# Values reported by scripts/prepare-sandbox-host.sh on the Worker host.
DLR_SANDBOX_CGROUP_PARENT=/system.slice/dlr-wave1a-worker.service
DLR_SANDBOX_CGROUP_SOURCE=/sys/fs/cgroup/system.slice/dlr-wave1a-worker.service
# These finite aggregate limits must cover Agent, Claim receiver and task.
DLR_WORKER_CPU_LIMIT=2.5
DLR_WORKER_MEMORY_LIMIT=2684354560
DLR_WORKER_PIDS_LIMIT=512
# Optional only after the documented supervised host stop and admin intent.
# Empty keeps the ordinary conservative startup gate.
DLR_WORKER_RECOVERY_OPERATION=
# Wave 2 only. Provision the verifier key in the private mounted directory.
DLR_WORKER_CAPACITY_SIGNING_KEY_FILE=
