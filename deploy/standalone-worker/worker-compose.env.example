# Copy outside the repository. Every address/name below is a placeholder.
COMPOSE_PROJECT_NAME=dlr-wave1a-worker
DLR_WORKER_IMAGE=registry.example.invalid/dlr-worker@sha256:REPLACE_WITH_REVIEWED_DIGEST
DLR_CONTROL_URL=https://control.example.invalid
DLR_WORKER_ID=REPLACE_WITH_RESERVED_ID
DLR_WORKER_IDENTITY_ID=REPLACE_WITH_RESERVED_UUID
DLR_WORKER_RUNTIME_VOLUME=dlr-wave1a-worker-runtime
DLR_WORKER_JOURNAL_ANCHOR_HOST_PATH=/ABSOLUTE/PERSISTENT/PARENT/journal
DLR_WORKER_PRIVATE_DIRECTORY=/ABSOLUTE/PRIVATE/DIRECTORY
# Values reported by scripts/prepare-sandbox-host.sh on the Worker host.
DLR_SANDBOX_CGROUP_PARENT=/system.slice/dlr-wave1a-worker.service
DLR_SANDBOX_CGROUP_SOURCE=/sys/fs/cgroup/system.slice/dlr-wave1a-worker.service
# These finite aggregate limits must cover Agent, Claim receiver and task.
DLR_WORKER_CPU_LIMIT=2.5
DLR_WORKER_MEMORY_LIMIT=2684354560
DLR_WORKER_PIDS_LIMIT=512
