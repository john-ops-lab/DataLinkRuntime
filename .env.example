# DataLinkRuntime 本地配置示例。
# 复制为 .env 后修改；只放占位值，绝不提交真实凭据。

# Control / Web 管理员 Token（管理员 API 与 Web UI 登录使用）
DLR_ADMIN_TOKEN=change-me-admin-token

# Worker 注册 / 心跳 / 领取任务使用的 Token
DLR_WORKER_TOKEN=change-me-worker-token

# Control 有效在线判定的心跳超时（秒，必须为正数；默认 30）
# 必须严格大于 Worker 心跳间隔；建议不少于心跳间隔的约 3 倍。
DLR_WORKER_HEARTBEAT_TIMEOUT_SECONDS=30

# Web 服务宿主机端口
DLR_WEB_HOST_PORT=8080

# M3.2 Secret Store 主密钥：Control 用它派生 Fernet 密钥加密凭据（HKDF-SHA256），
# 只存在于部署环境，从不落库/不落日志。未配置时凭据 API 返回 503。
DLR_MASTER_KEY=change-me-master-key

# AI Provider HTTP deadline（秒）。默认 180；允许范围 10～600。
# M4 使用非流式完整 Candidate，较长的上限避免健康思考模型被 30 秒误判超时。
DLR_AI_PROVIDER_TIMEOUT_SECONDS=180

# M5.2 Schedule Trigger：Control 调度循环轮询间隔（秒，默认 5；允许 0.5～300）。
DLR_SCHEDULE_POLL_SECONDS=5

# Worker 名称（可选，默认 worker-1）
DLR_WORKER_NAME=worker-1

# Worker 心跳间隔（秒，默认 10）
DLR_WORKER_HEARTBEAT_SECONDS=10

# 可选的 Worker 依赖源兼容配置；系统设置中对应类型的默认源优先。
DLR_PYPI_INDEX_URL=
DLR_NPM_REGISTRY_URL=
DLR_MAVEN_REPOSITORY_URL=

# Runtime Secret 示例：只注入 Worker，Adapter 通过 context.secrets.get("SMOKE") 读取
DLR_SECRET_SMOKE=change-me-smoke-secret

# --- 容器网络 / DNS（M5.5.8）---
# control / worker 默认使用：Docker 内置解析器（127.0.0.11，负责内部服务名）
# + 公共 DNS 回退（1.1.1.1 / 8.8.8.8）。127.0.0.11 必须保持第一项，否则
# postgres / control 等内部服务名无法解析。
#
# 企业 / VPN / 私有 DNS 场景：把回退地址改为你所在网络实际可用的 DNS，例如
#   DLR_DNS_FALLBACK_1=10.0.0.53
#   DLR_DNS_FALLBACK_2=
# 要完全关闭公共 DNS 回退（回到纯 Docker 内置解析器，即旧默认行为），把两个
# 回退都置空：
#   DLR_DNS_FALLBACK_1=
#   DLR_DNS_FALLBACK_2=
# 一般不需要修改 DLR_DNS_PRIMARY。
DLR_DNS_FALLBACK_1=
DLR_DNS_FALLBACK_2=
