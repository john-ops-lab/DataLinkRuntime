# DataLinkRuntime 本地配置示例。
# 复制为 .env 后修改；只放占位值，绝不提交真实凭据。

# Control / Web 管理员 Token（管理员 API 与 Web UI 登录使用）
DLR_ADMIN_TOKEN=change-me-admin-token

# Worker 注册 / 心跳 / 领取任务使用的 Token
DLR_WORKER_TOKEN=change-me-worker-token

# Control 有效在线判定的心跳超时（秒，必须为正数；默认 30）
# 必须严格大于 Worker 心跳间隔；建议不少于心跳间隔的约 3 倍。
DLR_WORKER_HEARTBEAT_TIMEOUT_SECONDS=30

# Web 服务宿主机端口
DLR_WEB_HOST_PORT=8080

# 账号登录 Web 服务宿主机端口（与 Token 入口共用 Control、PostgreSQL 和 Web 构建）
DLR_ACCOUNT_WEB_HOST_PORT=8081

# M3.2 Secret Store 主密钥：Control 用它派生 Fernet 密钥加密凭据（HKDF-SHA256），
# 只存在于部署环境，从不落库/不落日志。未配置时凭据 API 返回 503。
DLR_MASTER_KEY=change-me-master-key

# AI Provider HTTP deadline（秒）。默认 180；允许范围 10～600。
# M4 使用非流式完整 Candidate，较长的上限避免健康思考模型被 30 秒误判超时。
DLR_AI_PROVIDER_TIMEOUT_SECONDS=180

# 单次 AI Assist 的总时限（秒）：默认 150，只允许 120～180；最后 30 秒保留给
# 禁用工具的安全最终回答，任何单次 Provider timeout 都不能越过该总时限。
DLR_AI_ASSIST_TOTAL_TIMEOUT_SECONDS=150

# M5.7 Wave C2 只读 KnowledgeSource（首个目标：腾讯 ima，官方 OpenAPI）。
# 官方契约（来自官方 ima skill 包 @tencent-adm/ima-skills）：
#   base https://ima.qq.com（默认 endpoint；自定义地址仅允许部署环境覆盖）
#   鉴权头 ima-openapi-clientid / ima-openapi-apikey，响应封装 {code,msg,data}
#   list=search_knowledge_base(+get_knowledge_base 详情)；search=search_knowledge；
#   read=get_media_info →（笔记 get_doc_content / 官方媒体 URL 有界抓取）
# 生产配置必须满足：
#   - DLR_IMA_ENDPOINT 必须是 HTTPS，且主机名在 DLR_IMA_ALLOWED_HOSTS 官方白名单内；
#   - Client ID / API Key 存入 DLR access_key 类型 Credential（Secret Store，
#     字段 access_key_id=Client ID / access_key_secret=API Key），通过
#     DLR_IMA_CREDENTIAL_NAME 引用凭据名，绝不写入本文件/环境变量明文；
#   - DLR_IMA_ALLOW_HTTP 只是测试/smoke 逃生阀（仅允许在私有网络对 fake 官方服务开启），
#     生产必须保持 false（默认）。
# 系统设置 → 知识库可持久化启用状态与 access_key Credential 引用；数据库中
# 有配置时优先使用数据库。没有数据库配置行时，以下环境变量继续作为兼容回退。
# 未配置凭据时，AI 助手调用 list_knowledge_bases / search_knowledge / read_knowledge
# 会返回稳定的 ks_credential_invalid 错误，不影响其余功能。
# DLR_IMA_ENDPOINT=https://ima.qq.com
# DLR_IMA_CREDENTIAL_NAME=
# DLR_IMA_ALLOWED_HOSTS=ima.qq.com
# DLR_IMA_ALLOW_HTTP=false
# DLR_IMA_TIMEOUT_SECONDS=8

# M5.2 Schedule Trigger：Control 调度循环轮询间隔（秒，默认 5；允许 0.5～300）。
DLR_SCHEDULE_POLL_SECONDS=5

# M5.11 Wave B platform logs. For local development, keep the host-side bind
# root in the repository and writable by the current user:
#   DLR_PLATFORM_LOG_ROOT=./platform-logs
# Linux production uses a different absolute path on a persistent disk:
#   DLR_PLATFORM_LOG_ROOT=/var/lib/dlr/platform-logs
# Compose binds these five host subdirectories into the services:
#   control/ worker/ web/ account-web/ postgres/
# The postgres/ directory must be writable by the postgres container user;
# inspect `id postgres` in the pinned image and grant only the required access.
# Do not use chmod 777. The in-container path stays /var/lib/dlr/platform-logs;
# rotation and application log redaction remain enabled for the bind mount.
DLR_PLATFORM_LOG_ROOT=./platform-logs

# Issue #127 Managed Input Store (Wave B). The Compose deployment maps this
# in-container path to the named `dlr_artifact_store` volume. Keep the flag off
# until the Wave B/C release gates and protocol drain have passed.
DLR_ARTIFACT_STORE_ROOT=/var/lib/dlr/artifacts
DLR_MANAGED_FILES_ENABLED=false
DLR_ARTIFACT_DELETE_ALERT_THRESHOLD=5
DLR_ARTIFACT_GC_INTERVAL_SECONDS=300
DLR_ARTIFACT_AUDIT_INTERVAL_SECONDS=3600

# Bounded recovery settings. These deployment
# values are snapshotted into new Executions; existing Executions keep their
# original values. Keep cleanup_total strictly below recovery_grace and
# cleanup_attempt no greater than cleanup_total.
DLR_EXECUTION_CLAIM_TIMEOUT_SECONDS=300
DLR_EXECUTION_RECOVERY_GRACE_SECONDS=60
DLR_WORKSPACE_CLEANUP_ATTEMPT_TIMEOUT_SECONDS=5
DLR_WORKSPACE_CLEANUP_TOTAL_TIMEOUT_SECONDS=20
# Control's default for new Adapters remains 5 minutes. Worker advertises
# the full API-supported 24-hour ceiling so longer per-Adapter values do not
# fail only after the task has already been accepted.
DLR_EXECUTION_TIMEOUT_SECONDS=300
DLR_WORKER_EXECUTION_TIMEOUT_MAX_SECONDS=86400
DLR_EXECUTION_STREAM_MAX_BYTES=1048576
DLR_EXECUTION_OUTPUT_MAX_BYTES=524288
DLR_EXECUTION_OUTPUT_PREVIEW_MAX_BYTES=16384
# RabbitMQ Execution Retry Policy snapshot.
DLR_EXECUTION_RETRY_MAX_ATTEMPTS=3
DLR_EXECUTION_RETRY_INITIAL_BACKOFF_SECONDS=5
DLR_EXECUTION_RETRY_MULTIPLIER=2.0
DLR_EXECUTION_RETRY_MAX_BACKOFF_SECONDS=300
DLR_EXECUTION_RETRY_JITTER_RATIO=0.2

# RabbitMQ is the only execution backend. Replace the example non-guest
# broker credential. A single Quorum Queue node is durable but not HA.
DLR_RABBITMQ_USER=dlr_runtime
DLR_RABBITMQ_PASSWORD=change-me-rabbitmq-password
# This value is the raw broker vhost passed to RABBITMQ_DEFAULT_VHOST.
DLR_RABBITMQ_VHOST=/
# Control and Worker receive this same raw value and encode it once when
# constructing their AMQP URL; do not maintain a second URL-path value.
# The management API endpoint is an explicit, internal HTTP/TLS choice; it is
# not inferred from amqp/amqps listener ports. The default Compose file does
# not publish the management listener. For isolated local inspection only:
#   docker compose -f docker-compose.yml -f docker-compose.management.yml \
#     --profile management up -d rabbitmq
# This optional profile binds the management listener to localhost only.
DLR_RABBITMQ_MANAGEMENT_URL=http://rabbitmq:15672
# Optional localhost host port used only by docker-compose.management.yml.
# DLR_RABBITMQ_MANAGEMENT_HOST_PORT=15672
DLR_RABBITMQ_CAPABILITY_CACHE_SECONDS=3600
DLR_RABBITMQ_CONSUMER_TIMEOUT_MS=300000
DLR_RABBITMQ_QUEUE_MAX_LENGTH=2000
DLR_RABBITMQ_QUEUE_MAX_BYTES=67108864
DLR_RABBITMQ_DELIVERY_LIMIT=5
DLR_RABBITMQ_DISPATCH_MESSAGE_MAX_BYTES=16384
# The PostgreSQL Outbox protection line must fit at least one maximum dispatch
# message; otherwise startup fails closed.
DLR_OUTBOX_MAX_PENDING_BYTES=67108864
DLR_RABBITMQ_PUBLISH_TIMEOUT_SECONDS=10
DLR_RABBITMQ_STACK_TIMEOUT_SECONDS=10
DLR_RABBITMQ_CLAIM_HANDSHAKE_TIMEOUT_SECONDS=30
DLR_RABBITMQ_OUTBOX_LEASE_SECONDS=60
DLR_RABBITMQ_RETRY_BASE_SECONDS=1
DLR_RABBITMQ_RETRY_MAX_SECONDS=60
# RabbitMQ 4.3 Quorum native DEFER uses basic.nack(requeue=true). `all`
# delays both explicit returns and connection/channel returns; use `returned`
# for only explicit native returns.
DLR_RABBITMQ_DELAYED_RETRY_TYPE=all
# Relay publisher windows are finite; the queue bounds must leave the
# configured Broker headroom after the maximum confirm window.
DLR_RABBITMQ_PUBLISHER_CHANNEL_COUNT=4
DLR_RABBITMQ_PUBLISHER_MAX_CONCURRENCY=4
DLR_RABBITMQ_PUBLISHER_MAX_CONFIRM_INFLIGHT=4
DLR_RABBITMQ_BROKER_HEADROOM_MESSAGES=16
DLR_RABBITMQ_BROKER_HEADROOM_BYTES=262144
DLR_ADMISSION_ADAPTER_MAX_COUNT=100
DLR_ADMISSION_ADAPTER_MAX_BYTES=1073741824
DLR_ADMISSION_GLOBAL_MAX_COUNT=1000
DLR_ADMISSION_GLOBAL_MAX_BYTES=10737418240
DLR_ADMISSION_RECONCILE_BATCH_SIZE=100
DLR_OUTBOX_MAX_PENDING_COUNT=2000
DLR_OUTBOX_MAX_OLDEST_SECONDS=900
DLR_ATTEMPT_LEASE_SECONDS=60
DLR_ATTEMPT_RENEW_SECONDS=15
DLR_ATTEMPT_RECONCILE_INTERVAL_SECONDS=5
DLR_IDEMPOTENCY_RETENTION_SECONDS=86400
DLR_DEAD_LETTER_HOLD_SECONDS=604800
DLR_DEAD_LETTER_HOLD_MAX_COUNT=10000
DLR_DEAD_LETTER_HOLD_MAX_BYTES=10737418240
DLR_SANDBOX_BACKEND=cgroup_v2
DLR_SANDBOX_CPU_CORES=1.0
DLR_SANDBOX_MEMORY_BYTES=536870912
DLR_SANDBOX_PIDS=128
DLR_SANDBOX_TMP_BYTES=1073741824
DLR_SANDBOX_NOFILE=1024

# Required Linux cgroup v2 delegation on the Docker daemon host.
# Run sudo bash scripts/prepare-sandbox-host.sh before the first Compose start.
# For a separate instance, pass --unit dlr-YOUR_INSTANCE.service and copy the
# two values printed by that command. Never use the cgroup root or app.slice.
# The Worker uses a private cgroup namespace and binds only this exact subtree.
DLR_SANDBOX_CGROUP_PARENT=/system.slice/dlr-worker-sandbox.service
DLR_SANDBOX_CGROUP_SOURCE=/sys/fs/cgroup/system.slice/dlr-worker-sandbox.service
DLR_SANDBOX_PAYLOAD_UID=501
DLR_SANDBOX_PAYLOAD_GID=1000

# AI 工具审计固定写入 control/ai-tool-audit.jsonl，由 Control 应用按大小轮转，
# 不受宿主机仅匹配 *.log 的 logrotate 重复处理。单文件默认 10 MiB（允许
# 1～104857600 bytes），默认保留 10 个历史文件（允许 1～100），因此默认最坏
# 占用为当前文件 + 10 份历史文件 = 110 MiB。日志只含脱敏元数据；不得写入
# Prompt、附件、源码、工具结果、reasoning、原始响应或任何真实凭据。
DLR_AI_TOOL_AUDIT_MAX_BYTES=10485760
DLR_AI_TOOL_AUDIT_BACKUP_COUNT=10
# 回滚旧版 Control/Web 时删除以上三个新增 AI 配置；既有 ai-tool-audit.jsonl*
# 可按部署保留策略继续保留或人工删除，无数据库迁移或数据回迁。

# M5.11 Wave B terminal Execution retention. Cleanup never deletes pending or
# running rows and commits retryable batches. See docs/deployment/platform-logs.md.
DLR_EXECUTION_RETENTION_WEBHOOK_DAYS=30
DLR_EXECUTION_RETENTION_WEBHOOK_MAX_PER_ADAPTER=100
DLR_EXECUTION_RETENTION_TASK_DAYS=30
DLR_EXECUTION_RETENTION_TASK_MAX_PER_ADAPTER=1000
DLR_EXECUTION_RETENTION_SCHEDULE_DAYS=90
DLR_EXECUTION_RETENTION_SCHEDULE_MAX_PER_ADAPTER=1000
DLR_EXECUTION_RETENTION_BATCH_SIZE=100
DLR_EXECUTION_RETENTION_INTERVAL_SECONDS=3600

# Worker 名称（可选，默认 worker-1）
DLR_WORKER_NAME=worker-1

# Worker 心跳间隔（秒，默认 10）
DLR_WORKER_HEARTBEAT_SECONDS=10

# Worker 本地执行槽；默认宿主委派 3 CPU / 3 GiB，支持 2 个默认槽并保留管理进程余量。
DLR_WORKER_EXECUTION_SLOTS=2

# 可选的 Worker 依赖源兼容配置；系统设置中对应类型的默认源优先。
DLR_PYPI_INDEX_URL=
DLR_NPM_REGISTRY_URL=
DLR_MAVEN_REPOSITORY_URL=

# Runtime Secret 示例：只注入 Worker，Adapter 通过 context.secrets.get("SMOKE") 读取
DLR_SECRET_SMOKE=change-me-smoke-secret

# --- 容器网络 / DNS（M5.5.8）---
# control / worker 默认使用：Docker 内置解析器（127.0.0.11，负责内部服务名）
# + 公共 DNS 回退（1.1.1.1 / 8.8.8.8）。127.0.0.11 必须保持第一项，否则
# postgres / control 等内部服务名无法解析。
#
# 企业 / VPN / 私有 DNS 场景：把回退地址改为你所在网络实际可用的 DNS，例如
#   DLR_DNS_FALLBACK_1=10.0.0.53
#   DLR_DNS_FALLBACK_2=
# 要完全关闭公共 DNS 回退（回到纯 Docker 内置解析器，即旧默认行为），把两个
# 回退都置空：
#   DLR_DNS_FALLBACK_1=
#   DLR_DNS_FALLBACK_2=
# 一般不需要修改 DLR_DNS_PRIMARY。本文件不写这两个变量：compose 对
# 「已设置但为空」的变量不取默认值，生效的空赋值会让公共 DNS 回退丢失；
# 未设置时默认即为 127.0.0.11 → 1.1.1.1 → 8.8.8.8。
